Button saveSettings = new Button(this);
        saveSettings.setText("保存设置并重新加载桌宠");
        saveSettings.setOnClickListener(v -> {
            settingPrefs.edit()
                    .putBoolean("rest_enabled", restEnabled.isChecked())
                    .putInt("rest_minutes", minuteValues[restSpinner.getSelectedItemPosition()])
                    .putInt("pet_size", sizeSpinner.getSelectedItemPosition())
                    .putBoolean("rig_enabled", rigEnabled.isChecked())
                    .putInt("rig_strength", rigSpinner.getSelectedItemPosition())
                    .putBoolean("blink_enabled", blinkEnabled.isChecked())
                    .putBoolean("perch_enabled", perchEnabled.isChecked())
                    .putBoolean("auto_drop", autoDrop.isChecked())
                    .putBoolean("auto_sleep", autoSleep.isChecked())
                    .putBoolean("wander_enabled", wanderEnabled.isChecked())
                    .putInt("wander_seconds", wanderSeconds[wanderSpinner.getSelectedItemPosition()])
                    .putInt("sleep_seconds", sleepValues[sleepSpinner.getSelectedItemPosition()])
                    .putInt("physics_mode", physicsSpinner.getSelectedItemPosition())
                    .putInt("speech_mode", speechSpinner.getSelectedItemPosition())
                    .putBoolean("micro_actions", microActions.isChecked())
                    .putBoolean("mood_memory", moodMemory.isChecked())
                    .putBoolean("landing_reaction", landingReaction.isChecked())
                    .putInt("personality_mode", personalitySpinner.getSelectedItemPosition())
                    .apply();
            if (Settings.canDrawOverlays(this)) {
                stopService(new Intent(this, PetOverlayService.class));
                startPetService(new Intent(this, PetOverlayService.class));
            }
            Toast.makeText(this, "设置已保存", Toast.LENGTH_SHORT).show();
        });
        root.addView(saveSettings);

        TextView todoTitle = label("待办", 20);
        todoTitle.setPadding(0, dp(18), 0, dp(8));
        root.addView(todoTitle);

        Button add = new Button(this);
        add.setText("＋ 添加待办");
        add.setOnClickListener(v -> askTodo());
        root.addView(add);

        listBox = new LinearLayout(this);
        listBox.setOrientation(LinearLayout.VERTICAL);
        root.addView(listBox);
        refreshTodos();

        TextView tips = label("互动：轻点会回应，长按摸头可以安抚，快速双击打开设置。V0.8 增加情绪记忆：连续快速拖拽或重落地会让她短暂闹别扭，但不会一直记仇；安抚/摸头会快速恢复。空闲时还会张望、摆尾、歪头或短暂发呆，落地也会按力度出现不同反应。", 13);
        tips.setPadding(0, dp(18), 0, 0);
        root.addView(tips);

        ScrollView scroll = new ScrollView(this);
        scroll.addView(root);
        setContentView(scroll);
    }

    private JSONArray loadTodos() {
        try {
            return new JSONArray(todoPrefs.getString("items", "[]"));
        } catch (Exception e) {
            return new JSONArray();
        }
    }

    private void saveTodos(JSONArray array) {
        todoPrefs.edit().putString("items", array.toString()).apply();
    }

    private void refreshTodos() {
        listBox.removeAllViews();
        JSONArray array = loadTodos();
        if (array.length() == 0) {
            TextView empty = label("还没有待办。鲸鱼娘暂时可以安心摸鱼～", 15);
            empty.setPadding(dp(4), dp(12), dp(4), dp(12));
            listBox.addView(empty);
            return;
        }

        SimpleDateFormat format = new SimpleDateFormat("MM-dd HH:mm", Locale.getDefault());
        for (int i = 0; i < array.length(); i++) {
            try {
                JSONObject item = array.getJSONObject(i);
                LinearLayout line = new LinearLayout(this);
                line.setGravity(Gravity.CENTER_VERTICAL);
                line.setPadding(0, dp(3), 0, dp(3));

                CheckBox check = new CheckBox(this);
                check.setText(item.getString("title") + "\n" + format.format(new Date(item.getLong("due"))));
                check.setChecked(item.optBoolean("done"));
                final long itemId = item.optLong("id", 0L);
                check.setOnCheckedChangeListener((CompoundButton button, boolean checked) -> {
                    try {
                        JSONArray latest = loadTodos();
                        for (int k = 0; k < latest.length(); k++) {
                            JSONObject obj = latest.getJSONObject(k);
                            if (obj.optLong("id", -1L) == itemId) {
                                obj.put("done", checked);
                                break;
                            }
                        }
                        saveTodos(latest);
                    } catch (Exception ignored) {
                    }
                });
                line.addView(check, new LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1));

                Button delete = new Button(this);
                delete.setText("删");
                delete.setOnClickListener(v -> deleteTodo(itemId));
                line.addView(delete);
                listBox.addView(line);
            } catch (Exception ignored) {
            }
        }
    }

    private void deleteTodo(long itemId) {
        JSONArray input = loadTodos();
        JSONArray output = new JSONArray();
        for (int i = 0; i < input.length(); i++) {
            JSONObject item = input.optJSONObject(i);
            if (item != null && item.optLong("id", -1L) != itemId) output.put(item);
        }
        saveTodos(output);
        refreshTodos();
    }

    private void askTodo() {
        EditText edit = new EditText(this);
        edit.setHint("例如：交高数作业");
        new AlertDialog.Builder(this)
                .setTitle("添加待办")
                .setView(edit)
                .setPositiveButton("下一步", (dialog, which) -> {
                    String title = edit.getText().toString().trim();
                    if (!title.isEmpty()) pickWhen(title);
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private void pickWhen(String title) {
        Calendar calendar = Calendar.getInstance();
        calendar.add(Calendar.HOUR_OF_DAY, 1);
        new DatePickerDialog(this, (picker, year, month, day) ->
                new TimePickerDialog(this, (timePicker, hour, minute) -> {
                    calendar.set(year, month, day, hour, minute, 0);
                    calendar.set(Calendar.MILLISECOND, 0);
                    long id = System.currentTimeMillis();
                    try {
                        JSONArray array = loadTodos();
                        array.put(new JSONObject()
                                .put("id", id)
                                .put("title", title)
                                .put("due", calendar.getTimeInMillis())
                                .put("done", false));
                        saveTodos(array);
                        schedule(id, title, calendar.getTimeInMillis());
                        refreshTodos();
                    } catch (Exception ignored) {
                    }
                }, calendar.get(Calendar.HOUR_OF_DAY), calendar.get(Calendar.MINUTE), true).show(),
                calendar.get(Calendar.YEAR), calendar.get(Calendar.MONTH), calendar.get(Calendar.DAY_OF_MONTH)).show();
    }

    private void schedule(long id, String title, long at) {
        AlarmManager alarmManager = (AlarmManager) getSystemService(ALARM_SERVICE);
        Intent intent = new Intent(this, ReminderReceiver.class).putExtra("title", title);
        PendingIntent pending = PendingIntent.getBroadcast(
                this,
                (int) (id % Integer.MAX_VALUE),
                intent,
                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE
        );

        if (Build.VERSION.SDK_INT >= 31 && !alarmManager.canScheduleExactAlarms()) {
            alarmManager.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, pending);
        } el